{
  "_comment": "File patterns and column names for the PPMI clinical data cut, written before download from PPMI's documented study-data file conventions. Names will be checked against the downloaded data dictionaries. Any change here after download is a name-only fix: it is logged in ACTIVITY.md with its date and does not touch the analysis logic in scripts/ppmi_load.py.",
  "date_formats": ["%m/%Y", "%Y-%m-%d", "%m/%d/%Y", "%d%b%Y"],
  "date_day_if_month_only": 15,
  "tables": {
    "demographics": {"file": "Demographics*.csv", "PATNO": "PATNO", "sex": "SEX", "sex_female_value": 0, "birth": "BIRTHDT"},
    "diagnosis": {"file": "PD_Diagnosis_History*.csv", "PATNO": "PATNO", "dx_date": "PDDXDT", "onset_date": "SXDT"},
    "baseline": {"file": "MDS-UPDRS_Part_III*.csv", "PATNO": "PATNO", "event": "EVENT_ID", "baseline_event": "BL", "date": "INFODT"},
    "updrs3": {"file": "MDS-UPDRS_Part_III*.csv", "PATNO": "PATNO", "event": "EVENT_ID", "date": "INFODT", "total": "NP3TOT", "treated": "PDTRTMNT", "state": "PDSTATE"},
    "updrs2": {"file": "MDS_UPDRS_Part_II__Patient_Questionnaire*.csv", "PATNO": "PATNO", "event": "EVENT_ID", "date": "INFODT", "total": "NP2PTOT"},
    "datscan": {"file": "DaTScan_Analysis*.csv", "PATNO": "PATNO", "date": "INFODT", "put_l": "DATSCAN_PUTAMEN_L", "put_r": "DATSCAN_PUTAMEN_R"},
    "ledd": {"file": "LEDD*.csv", "PATNO": "PATNO", "event": "EVENT_ID", "date": "INFODT", "ledd": "LEDD"},
    "saa": {"file": "SAA*.csv", "PATNO": "PATNO", "date": "RUNDATE", "result": "SAA_Status", "positive_values": ["Positive"], "negative_values": ["Negative"]},
    "nsd_iss": {"file": "*NSD*ISS*.csv", "PATNO": "PATNO", "date": "INFODT", "stage": "NSD_ISS_STAGE"}
  }
}
